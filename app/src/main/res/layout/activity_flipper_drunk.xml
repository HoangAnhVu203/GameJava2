<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FlipperDrunk.FlipperDrunk">

    <com.example.game43.FlipperDrunk.FlipperDrunkGameView
        android:id="@+id/flipperDrunkGame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/flipperStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

        <ImageView
            android:id="@+id/flipperBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ui_07" />

        <ImageView
            android:id="@+id/flipperLeftWall"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ui_06" />

        <ImageView
            android:id="@+id/flipperRightWall"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ui_04" />

        <ImageView
            android:id="@+id/flipperHoopBack"
            android:layout_width="96dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/basketball_hoop_back_layer" />

        <ImageView
            android:id="@+id/flipperBall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bong" />

        <ImageView
            android:id="@+id/flipperPaddle"
            android:layout_width="148dp"
            android:layout_height="86dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ui_05" />

        <ImageView
            android:id="@+id/flipperHoopFront"
            android:layout_width="82dp"
            android:layout_height="68dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/basketball_hoop_front_layer" />

        <TextView
            android:id="@+id/flipperScore"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        </FrameLayout>
    </com.example.game43.FlipperDrunk.FlipperDrunkGameView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flipperDrunkGameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#84000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/flipperDrunkGameOverPopup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="225:261"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintWidth_percent="0.58">

            <ImageView
                android:id="@+id/flipperDrunkGameOverPopupImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/popup"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/flipperDrunkGameOverTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Bạn có muốn\nchơi lượt nữa\nhay không?"
                android:textColor="#424242"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@id/flipperDrunkPlayAgainButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.9"
                app:layout_constraintWidth_percent="0.75" />

            <FrameLayout
                android:id="@+id/flipperDrunkPlayAgainButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/flipperDrunkQuitButton"
                app:layout_constraintHeight_percent="0.14"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.72"
                app:layout_constraintWidth_percent="0.34">

                <ImageView
                    android:id="@+id/flipperDrunkPlayAgainButtonImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/button_popup1" />

                <TextView
                    android:id="@+id/flipperDrunkPlayAgainButtonText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Có"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flipperDrunkQuitButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/flipperDrunkPlayAgainButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.14"
                app:layout_constraintStart_toEndOf="@id/flipperDrunkPlayAgainButton"
                app:layout_constraintTop_toTopOf="@id/flipperDrunkPlayAgainButton"
                app:layout_constraintWidth_percent="0.34">

                <ImageView
                    android:id="@+id/flipperDrunkQuitButtonImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/button_popup2" />

                <TextView
                    android:id="@+id/flipperDrunkQuitButtonText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Không"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
