<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061C31"
    tools:context=".RocketLaunch.RocketLaunch">

    <ImageView
        android:id="@+id/spaceBackgroundTwo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/rocket_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/spaceBackgroundOne"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/rocket_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/groundBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/rocket_ground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flightArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/launchButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/moneyPanel"
            android:layout_width="116dp"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/rocket_status_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="@null"
                android:src="@drawable/rocket_icon_income" />

            <TextView
                android:id="@+id/moneyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/flightStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rocket_status_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/altitudeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 m"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 m/s"
                android:textColor="#A9DFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/fuelPanel"
            android:layout_width="54dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="72dp"
            android:layout_marginBottom="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/rocket_icon_fuel" />

            <com.example.game43.RocketLaunch.RocketFuelView
                android:id="@+id/fuelView"
                android:layout_width="34dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/fuelValueText"
                android:layout_width="54dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:id="@+id/planet"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="108dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rocket_planet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/rocketSupport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/rocket_support"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="185:72"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="185dp"
            app:layout_constraintWidth_percent="0.49" />

        <ImageView
            android:id="@+id/rocketPlatform"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/rocket_platform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="174:63"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="174dp"
            app:layout_constraintWidth_percent="0.46" />

        <FrameLayout
            android:id="@+id/rocketActor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/rocketPlatform"
            app:layout_constraintDimensionRatio="176:320"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="320dp"
            app:layout_constraintHeight_percent="0.72"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="176dp">

            <FrameLayout
                android:id="@+id/rocketVisual"
                android:layout_width="176dp"
                android:layout_height="320dp"
                android:layout_gravity="bottom|center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

            <TextView
                android:id="@+id/holdLabel"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="5dp"
                android:elevation="4dp"
                android:gravity="center"
                android:text="HOLD"
                android:textColor="#FBC84A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <com.example.game43.RocketLaunch.RocketExhaustView
                android:id="@+id/rocketExhaust"
                android:layout_width="112dp"
                android:layout_height="150dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-85dp"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <View
                android:id="@+id/rocketFlame"
                android:layout_width="16dp"
                android:layout_height="38dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="5dp"
                android:background="@drawable/rocket_flame"
                android:pivotY="0"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/rocketImage"
                android:layout_width="60dp"
                android:layout_height="250dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="31dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/rocket" />

            </FrameLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/incomePopup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="+$1"
            android:textColor="#72D32D"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/rocketPlatform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/launchButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/rocket_launch_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="LAUNCH"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/upgradePanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="210dp"
        app:layout_constraintWidth_min="150dp"
        app:layout_constraintWidth_percent="0.55" />

    <FrameLayout
        android:id="@+id/upgradePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/rocket_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="224dp"
        app:layout_constraintHeight_min="150dp"
        app:layout_constraintHeight_percent="0.275"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/upgradeGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="7dp"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <include
                    layout="@layout/item_rocket_upgrade_speed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    layout="@layout/item_rocket_upgrade_income"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <include
                    layout="@layout/item_rocket_upgrade_fuel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    layout="@layout/item_rocket_upgrade_power"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
